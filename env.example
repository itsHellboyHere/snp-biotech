# =========================================================
# SNP Biotech website — environment variables
# Is file ko copy karke ".env.local" banao aur values bharo. (.env.local git mein nahi jaati)
# Hosting (Vercel wagairah) ki "Environment Variables" settings mein bhi yahi daalo.
# =========================================================

# ---------- Puchhtachh form → email (Resend) ----------
# Resend account CLIENT ki Gmail se banao → https://resend.com → API Keys → "Create API Key"
RESEND_API_KEY=
# Kis email pe puchhtachh aaye — khaali chhodo to lib/site.js ka enquiryEmail (snpbiotech5@gmail.com)
# ENQUIRY_TO=
# Bhejne wala — khaali chhodo to lib/site.js ka enquiryFrom (SNP Biotech Website <enquiry@snpbiotech.in>)
# snpbiotech.in Resend mein verify na ho to code apne aap onboarding@resend.dev se bhejta hai
# ENQUIRY_FROM=

# ---------- Cloudinary (launch se pehle — optimization) ----------
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

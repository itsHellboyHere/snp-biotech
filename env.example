# =========================================================
# SNP Biotech website — environment variables
# Is file ko copy karke ".env.local" banao aur values bharo. (.env.local git mein nahi jaati)
# Hosting (Vercel wagairah) ki "Environment Variables" settings mein bhi yahi daalo.
# =========================================================

# ---------- Puchhtachh form → email (Resend) ----------
# Resend account CLIENT ki Gmail se banao → https://resend.com → API Keys → "Create API Key"
RESEND_API_KEY=
# Kis email pe puchhtachh aaye (comma se kai email)
ENQUIRY_TO=
# Bhejne wala. Domain verify hone tak resend.dev wala hi chalega —
# tab tak email SIRF Resend account wali Gmail pe jaata hai.
# Domain (snpbiotech.in) verify hone ke baad: "SNP Biotech <enquiry@snpbiotech.in>"
ENQUIRY_FROM="SNP Biotech Website <onboarding@resend.dev>"

# ---------- Cloudinary (launch se pehle — optimization) ----------
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
